<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BiteRecord.Views"
       x:Class="BiteRecord.AppShell">

    <TabBar>
        <Tab Title="Records" Icon="food_list.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Hardware" Icon="hardware.png">
            <ShellContent ContentTemplate="{DataTemplate views:HardwarePage}" Route="HardwarePage" />
        </Tab>
        <Tab Title="Settings" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>

    <!-- Global routes - 注意大小写要与类名一致 -->
    <ShellContent Route="AddItemPage" ContentTemplate="{DataTemplate views:AddItemPage}" />

</Shell>