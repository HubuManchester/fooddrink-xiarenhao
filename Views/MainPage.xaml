<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiteRecord.Views.MainPage"
             Title="Bite Records">

    <Grid RowDefinitions="Auto, Auto, *">

        <SearchBar x:Name="SearchBar"
                   Grid.Row="0"
                   Placeholder="Search restaurant or dish..."
                   Margin="12,8"
                   TextChanged="OnSearchTextChanged"/>

        <Button x:Name="AddButton"
                Grid.Row="1"
                Text="+ Add New Record"
                BackgroundColor="#FF6B35"
                TextColor="White"
                CornerRadius="8"
                Margin="12,0,12,12"
                HeightRequest="50"
                Clicked="OnAddClicked"/>

        <CollectionView x:Name="RecordsCollection"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="OnRecordSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12"
                          Margin="12,4"
                          BackgroundColor="#FDF8F0"
                          RowDefinitions="Auto, Auto, Auto, Auto"
                          ColumnDefinitions="*, Auto">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding RestaurantName}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#2D3436"/>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding RatingDisplay}"
                               TextColor="#FF6B35"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="{Binding DishName}"
                               FontSize="14"
                               TextColor="#636E72"
                               Opacity="0.8"/>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="{Binding PriceDisplay}"
                               FontSize="12"
                               TextColor="#00B894"/>

                        <Label Grid.Row="2"
                               Grid.Column="1"
                               Text="{Binding DateDisplay}"
                               FontSize="12"
                               TextColor="#B2BEC3"
                               HorizontalOptions="End"/>

                        <BoxView Grid.Row="3"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="2"
                                 HeightRequest="1"
                                 Margin="0,8,0,0"
                                 Color="#E8E8E8"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel"
               Grid.Row="2"
               Text="No records yet. Tap + to add your first bite!"
               TextColor="#636E72"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False"/>
    </Grid>
</ContentPage>