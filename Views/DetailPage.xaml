<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BiteRecord.Views.DetailPage"
             Title="Detail">

    <ScrollView>
        <StackLayout Padding="16" Spacing="12">

            <Label x:Name="RestaurantLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#2D3436"
                   LineBreakMode="WordWrap"/>

            <Label x:Name="DishLabel"
                   FontSize="18"
                   TextColor="#636E72"
                   LineBreakMode="WordWrap"/>

            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="★" TextColor="#FF6B35" FontSize="20"/>
                <Label x:Name="RatingLabel" Grid.Column="1" FontSize="16"/>
            </Grid>

            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="💰" FontSize="16"/>
                <Label x:Name="PriceLabel" Grid.Column="1" FontSize="16"/>
            </Grid>

            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="📅" FontSize="16"/>
                <Label x:Name="DateLabel" Grid.Column="1" FontSize="16"/>
            </Grid>

            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="📍" FontSize="16"/>
                <Label x:Name="LocationLabel" Grid.Column="1" FontSize="14" TextColor="#636E72" LineBreakMode="WordWrap"/>
            </Grid>

            <Label x:Name="PhotoTitleLabel" Text="📷 Photo" FontAttributes="Bold" Margin="0,8,0,0"/>
            <Image x:Name="PhotoImage" HeightRequest="200" Aspect="AspectFill" Margin="0,4"/>

            <Label x:Name="ReviewTitleLabel" Text="📝 Review" FontAttributes="Bold" Margin="0,8,0,0"/>
            <Label x:Name="ReviewLabel" FontSize="14" TextColor="#2D3436" LineBreakMode="WordWrap"/>

            <BoxView HeightRequest="1" Color="#E8E8E8" Margin="0,16"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button x:Name="SpeakButton"
                        Text="🔊 Read Review"
                        BackgroundColor="#0984E3"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        Clicked="OnSpeakClicked"/>

                <Button x:Name="StopSpeakButton"
                        Text="⏹️ Stop"
                        BackgroundColor="#D63031"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        Clicked="OnStopSpeakClicked"/>
            </Grid>

            <Button x:Name="DeleteButton"
                    Text="🗑️ Delete Record"
                    BackgroundColor="#E8E8E8"
                    TextColor="#D63031"
                    CornerRadius="8"
                    HeightRequest="45"
                    Clicked="OnDeleteClicked"/>
        </StackLayout>
    </ScrollView>
</ContentPage>